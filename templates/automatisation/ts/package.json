{
  "name": "{{CODE}}-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Framework d'automatisation Playwright (TypeScript) pour {{APPLICATION}}",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
