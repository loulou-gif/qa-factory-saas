# QA Factory SaaS — réglages du serveur. Copier en .env (jamais dans Git), droits restreints : chmod 600 .env

# --- Application web
# Chaîne aléatoire longue (ex. : python3 -c "import secrets; print(secrets.token_urlsafe(48))")
QAF_SECRET=
# Premier administrateur, créé au premier démarrage si aucun compte n'existe (mot de passe à changer à la 1re connexion)
QAF_ADMIN_IDENTIFIANT=admin
QAF_ADMIN_NOM=Administrateur
QAF_ADMIN_MOT_DE_PASSE=
# true quand l'application est servie en HTTPS (recommandé)
QAF_COOKIE_SECURISE=false
QAF_TACHES_PARALLELES=2
QAF_DUREE_MAX_TACHE_MIN=90
QAF_PORT=8000

# --- Moteur OpenCode
# Mot de passe entre l'application et le moteur (chaîne aléatoire, jamais communiquée aux utilisateurs)
OPENCODE_SERVER_PASSWORD=
# Clé OpenRouter dédiée à l'outil, avec plafond mensuel (créée par l'administrateur du compte OpenRouter)
OPENROUTER_API_KEY=
# Modèle imposé, au format openrouter/<fournisseur>/<modèle> (choisi en phase 1 après comparaison).
# Pour un essai sans clé : simulation/demo (faux modèle qui rejoue une analyse de référence).
QAF_MODELE=simulation/demo

# --- Squash TM
# Chaque utilisateur règle sa propre connexion dans l'application (page « Squash ») : rien à mettre ici.
# Clé de chiffrement des mots de passe et jetons Squash enregistrés (Fernet). Vide : une clé est créée
# dans le volume « donnees ». La perdre oblige chaque utilisateur à ressaisir son secret.
# Générer : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QAF_CLE_SECRETS=
# true pour autoriser les adresses Squash d'un réseau interne (installation en entreprise, essais).
# Laisser false sur un service ouvert au public.
QAF_SQUASH_RESEAU_PRIVE=false
# Derrière un proxy d'entreprise (Node 22.21 ou plus) : décommenter
# NODE_USE_ENV_PROXY=1
