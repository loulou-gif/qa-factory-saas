{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:QAF_MODELE}",
  "small_model": "{env:QAF_MODELE}",
  "provider": {
    "google": {
      "options": {
        "baseURL": "relais/google",
        "apiKey": "jeton-du-relais"
      }
    },
    "openrouter": {
      "options": {
        "baseURL": "relais/openrouter",
        "apiKey": "jeton-du-relais"
      }
    },
    "groq": {
      "options": {
        "baseURL": "relais/groq",
        "apiKey": "jeton-du-relais"
      }
    },
    "cerebras": {
      "options": {
        "baseURL": "relais/cerebras",
        "apiKey": "jeton-du-relais"
      }
    },
    "mistral": {
      "options": {
        "baseURL": "relais/mistral",
        "apiKey": "jeton-du-relais"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "relais/deepseek",
        "apiKey": "jeton-du-relais"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "relais/anthropic",
        "apiKey": "jeton-du-relais"
      }
    },
    "openai": {
      "options": {
        "baseURL": "relais/openai",
        "apiKey": "jeton-du-relais"
      }
    }
  },
  "share": "disabled",
  "autoupdate": false,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ],
      "enabled": false
    },
    "squash-tm": {
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "skill": "allow",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "task": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "deny",
      "python *": "allow",
      "python3 *": "allow",
      "py *": "allow",
      "mkdir *": "allow",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "dir": "allow",
      "dir *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "type *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "echo *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "file *": "allow",
      "cp *": "allow",
      "pandoc *": "allow",
      "pdftotext *": "allow",
      "pdfinfo *": "allow",
      "soffice --headless *": "allow",
      "libreoffice --headless *": "allow",
      "unzip -l *": "allow",
      "unzip -p *": "allow",
      "npx playwright test*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "Remove-Item *": "deny",
      "mv *": "deny",
      "move *": "deny",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "Invoke-WebRequest *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "git push*": "deny",
      "npm *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "sudo *": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny"
    },
    "squash-tm_publish_validated_test_cases": "deny",
    "squash-tm_create_requirement": "deny",
    "squash-tm_create_requirement_folder": "deny",
    "squash-tm_create_test_case_folder": "deny",
    "squash-tm_create_standard_test_case": "deny",
    "squash-tm_add_action_step": "deny",
    "squash-tm_link_requirements_to_test_case": "deny",
    "squash-tm_link_requirements_to_test_step": "deny",
    "squash-tm_mark_test_case_automated": "deny",
    "squash-tm_create_keyword_test_case": "deny",
    "squash-tm_create_bdd_test_case": "deny",
    "squash-tm_update_bdd_test_case": "deny",
    "squash-tm_create_test_step": "deny",
    "squash-tm_update_test_step": "deny",
    "squash-tm_add_step_to_bdd_test_case": "deny",
    "squash-tm_update_step_in_bdd_test_case": "deny",
    "squash-tm_transmit_test_case": "deny",
    "squash-tm_run_automated_suite_batch": "deny"
  }
}
